generator client {
  provider = "prisma-client-js"
  output   = "../../apps/api/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [vector]
}

// ===== PHASE 6: INTELLIGENCE MODELS =====

// Knowledge base entries with vector embeddings
model Knowledge {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @map("workspace_id") @db.Uuid
  title           String
  content         String            @db.Text
  category        String            @default("general")
  tags            String[]          @default([])
  source          String?           // URL, document name, etc.
  vectorEmbeddingId String?         @map("vector_embedding_id") @db.Uuid
  isArchived      Boolean           @default(false) @map("is_archived")
  accessCount     Int               @default(0) @map("access_count")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vectorEmbedding KnowledgeVector?  @relation(fields: [vectorEmbeddingId], references: [id], onDelete: SetNull)
  citations       CitedSource[]
  
  @@index([workspaceId, category])
  @@index([workspaceId, createdAt])
  @@index([isArchived])
  @@map("knowledge")
}

// Vector embeddings for knowledge entries
model KnowledgeVector {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @map("workspace_id") @db.Uuid
  knowledgeId     String            @map("knowledge_id") @db.Uuid
  embedding       Unsupported("vector(1536)") @map("embedding")
  model           String            @default("text-embedding-3-small")
  metadata        Json              @default("{}")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledge       Knowledge[]
  
  @@unique([workspaceId, knowledgeId])
  @@index([workspaceId])
  @@map("knowledge_vectors")
}

// Chat conversations with AI assistant
model Conversation {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @map("workspace_id") @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  title           String            @default("New Conversation")
  summary         String?           @db.Text
  messageCount    Int               @default(0) @map("message_count")
  lastMessageAt   DateTime?         @map("last_message_at") @db.Timestamptz(6)
  isArchived      Boolean           @default(false) @map("is_archived")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        ConversationMessage[]
  
  @@index([workspaceId, userId])
  @@index([createdAt])
  @@index([isArchived])
  @@map("conversations")
}

// Individual messages in a conversation
model ConversationMessage {
  id              String            @id @default(uuid()) @db.Uuid
  conversationId  String            @map("conversation_id") @db.Uuid
  role            String            // "user" or "assistant"
  content         String            @db.Text
  sources         CitedSource[]
  metadata        Json              @default("{}")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  
  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

// Sources cited in assistant responses
model CitedSource {
  id              String            @id @default(uuid()) @db.Uuid
  messageId       String            @map("message_id") @db.Uuid
  knowledgeId     String?           @map("knowledge_id") @db.Uuid
  title           String
  url             String?
  content         String?           @db.Text
  relevanceScore  Float             @map("relevance_score")
  position        Int               // Position in the message
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  
  message         ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  knowledge       Knowledge?        @relation(fields: [knowledgeId], references: [id], onDelete: SetNull)
  
  @@index([messageId])
  @@index([knowledgeId])
  @@map("cited_sources")
}

// Daily optimized task plans
model DailyPlan {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @map("workspace_id") @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  planDate        DateTime          @map("plan_date") @db.Date
  taskIds         String[]          @default([]) @map("task_ids")
  timeBlocks      Json              @default("[]") @map("time_blocks") // Array of time blocks
  breaks          Json              @default("[]") // Break suggestions
  metrics         Json              @default("{}")  // Productivity metrics
  completionScore Float?            @map("completion_score") // 0-100
  isExecuted      Boolean           @default(false) @map("is_executed")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, planDate])
  @@index([workspaceId, planDate])
  @@index([userId, planDate])
  @@map("daily_plans")
}

// Data retention/deletion policies
model RetentionPolicy {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @map("workspace_id") @db.Uuid
  name            String
  description     String?           @db.Text
  dataType        String            // conversations, knowledge, messages, etc.
  retentionDays   Int               @map("retention_days")
  archiveOldData  Boolean           @default(true) @map("archive_old_data")
  autoExecute     Boolean           @default(true) @map("auto_execute")
  isActive        Boolean           @default(true) @map("is_active")
  lastExecutedAt  DateTime?         @map("last_executed_at") @db.Timestamptz(6)
  nextExecuteAt   DateTime?         @map("next_execute_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  @@index([workspaceId, dataType])
  @@index([workspaceId, isActive])
  @@map("retention_policies")
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SuggestionStatus {
  PENDING_APPROVAL
  APPROVED
  DISMISSED
}

model User {
  id          String            @id @default(uuid()) @db.Uuid
  email       String            @unique
  passwordHash String?          @map("password_hash")
  displayName String            @map("display_name")
  timezone    String            @default("UTC")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships WorkspaceMember[]
  devices     Device[]
  deviceInfos DeviceInfo[]
  tasks       Task[]
  sessions    AuthSession[]
  auditLogs   AuditLog[]
  conversations Conversation[]
  dailyPlans  DailyPlan[]
  externalIntegrations ExternalIntegration[]

  @@map("users")
}

model Workspace {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships WorkspaceMember[]
  devices     Device[]
  deviceInfos DeviceInfo[]
  integrations Integration[]
  messages    Message[]
  tasks       Task[]
  reminders   Reminder[]
  followUps   FollowUp[]
  notifications Notification[]
  suggestions Suggestion[]
  notes       Note[]
  embeddings  Embedding[]
  auditLogs   AuditLog[]
  oauthConnections OAuthConnection[]
  gmailSyncs  GmailSync[]
  androidNotifications AndroidNotification[]
  syncLogs    DeviceSyncLog[]
  offlineTasks OfflineTask[]
  syncQueue   SyncQueueItem[]
  syncConflicts SyncConflict[]
  knowledge   Knowledge[]
  knowledgeVectors KnowledgeVector[]
  conversations Conversation[]
  dailyPlans  DailyPlan[]
  retentionPolicies RetentionPolicy[]
  externalIntegrations ExternalIntegration[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        String    @default("owner")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Device {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  platform    String
  name        String?
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([workspaceId, userId])
  @@map("devices")
}

model Integration {
  id                String             @id @default(uuid()) @db.Uuid
  workspaceId       String             @map("workspace_id") @db.Uuid
  provider          String
  externalAccountId String?            @map("external_account_id")
  status            String             @default("disconnected")
  lastSyncedAt      DateTime?          @map("last_synced_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  token             IntegrationToken?
  messages          Message[]

  @@unique([workspaceId, provider, externalAccountId])
  @@index([workspaceId, status])
  @@map("integrations")
}

model IntegrationToken {
  id                    String      @id @default(uuid()) @db.Uuid
  integrationId         String      @unique @map("integration_id") @db.Uuid
  encryptedAccessToken  Bytes?      @map("encrypted_access_token")
  encryptedRefreshToken Bytes?      @map("encrypted_refresh_token")
  expiresAt             DateTime?   @map("expires_at") @db.Timestamptz(6)
  keyVersion            Int         @map("key_version")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  integration           Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("integration_tokens")
}

model Message {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  integrationId String          @map("integration_id") @db.Uuid
  externalId  String           @map("external_id")
  sender      String
  subject     String?
  preview     String
  content     String?
  sourceUrl   String?          @map("source_url")
  receivedAt  DateTime         @map("received_at") @db.Timestamptz(6)
  readAt      DateTime?        @map("read_at") @db.Timestamptz(6)
  archivedAt  DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration Integration      @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  analysis    MessageAnalysis?
  followUps   FollowUp[]
  suggestions Suggestion[]
  tasks       Task[]
  embeddings  Embedding[]

  @@unique([integrationId, externalId])
  @@index([workspaceId, receivedAt])
  @@index([workspaceId, archivedAt, receivedAt])
  @@map("messages")
}

model MessageAnalysis {
  id            String   @id @default(uuid()) @db.Uuid
  messageId     String   @unique @map("message_id") @db.Uuid
  category      String
  priority      Priority
  intent        String
  summary       String
  model         String
  promptVersion String   @map("prompt_version")
  confidence    Float
  latencyMs     Int      @map("latency_ms")
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  message       Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  entities      ExtractedEntity[]

  @@map("message_analysis")
}

model Task {
  id              String     @id @default(uuid()) @db.Uuid
  workspaceId     String     @map("workspace_id") @db.Uuid
  createdById     String     @map("created_by_id") @db.Uuid
  sourceMessageId String?    @map("source_message_id") @db.Uuid
  title           String
  description     String?
  dueAt           DateTime?  @map("due_at") @db.Timestamptz(6)
  timezone        String?
  priority        Priority   @default(MEDIUM)
  status          TaskStatus @default(PENDING)
  completedAt     DateTime?  @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sourceMessage   Message?   @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  subtasks        Subtask[]
  providerTasks   ProviderTask[]
  androidNotifications AndroidNotification[]

  @@index([workspaceId, status, dueAt])
  @@index([createdById, status])
  @@map("tasks")
}

model Subtask {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  title       String
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("subtasks")
}

model Reminder {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  title       String
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(6)
  timezone    String?
  recurrence  String?
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scheduledAt, completedAt])
  @@map("reminders")
}

model FollowUp {
  id                  String    @id @default(uuid()) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  sourceMessageId     String    @map("source_message_id") @db.Uuid
  expectedResponseAt  DateTime? @map("expected_response_at") @db.Timestamptz(6)
  status              String    @default("pending")
  draft               String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceMessage       Message   @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sourceMessageId])
  @@index([workspaceId, status, expectedResponseAt])
  @@map("follow_ups")
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  deviceId    String?   @map("device_id") @db.Uuid
  dedupeKey   String    @map("dedupe_key")
  title       String
  body        String
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  device      Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, scheduledAt, deliveredAt])
  @@map("notifications")
}

model Suggestion {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  sourceMessageId String           @map("source_message_id") @db.Uuid
  action          Json
  confidence      Float
  explanation     String
  status          SuggestionStatus @default(PENDING_APPROVAL)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceMessage   Message          @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@map("suggestions")
}

model Note {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  title       String
  content     String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  embeddings  Embedding[]

  @@index([workspaceId, updatedAt])
  @@map("notes")
}

model ExtractedEntity {
  id                String          @id @default(uuid()) @db.Uuid
  analysisId        String          @map("analysis_id") @db.Uuid
  entityType        String          @map("entity_type")
  value             String
  normalizedDate    DateTime?       @map("normalized_date") @db.Timestamptz(6)
  confidence        Float
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  analysis          MessageAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, entityType])
  @@map("extracted_entities")
}

model Embedding {
  id          String                  @id @default(uuid()) @db.Uuid
  workspaceId String                  @map("workspace_id") @db.Uuid
  messageId   String?                 @map("message_id") @db.Uuid
  noteId      String?                 @map("note_id") @db.Uuid
  contentHash String                  @map("content_hash")
  model       String
  vector      Unsupported("vector(1536)") @map("embedding")
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message     Message?                @relation(fields: [messageId], references: [id], onDelete: Cascade)
  note        Note?                   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, contentHash, model])
  @@index([workspaceId])
  @@map("embeddings")
}

model AuthSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  refreshHash  String    @unique @map("refresh_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  actorId     String?   @map("actor_id") @db.Uuid
  action      String
  objectType  String    @map("object_type")
  objectId    String?   @map("object_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

model OAuthConnection {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  provider      String
  userId        String    @map("user_id")
  accessToken   String    @map("access_token")
  refreshToken  String?   @map("refresh_token")
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)
  scopes        String[]
  connectedAt   DateTime  @default(now()) @map("connected_at") @db.Timestamptz(6)
  lastSyncAt    DateTime? @map("last_sync_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([revokedAt])
  @@map("oauth_connections")
}

model GmailSync {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  historyId      String    @map("history_id")
  lastSyncAt     DateTime  @default(now()) @map("last_sync_at") @db.Timestamptz(6)
  totalEmails    Int       @default(0) @map("total_emails")
  tasksCreated   Int       @default(0) @map("tasks_created")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId])
  @@index([lastSyncAt])
  @@map("gmail_syncs")
}

model AndroidNotification {
  id        String    @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  userId    String    @map("user_id")
  title     String
  body      String
  appPackage String  @map("app_package")
  timestamp DateTime
  taskId    String?   @map("task_id") @db.Uuid
  dismissed Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId, userId])
  @@index([dismissed])
  @@map("android_notifications")
}

// Phase 4.2: Prompt Management & Versioning
model PromptTemplate {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id") @db.Uuid
  name            String
  operation       String   // classify, summarize, extract, suggest
  description     String?
  category        String?  // work, personal, health, etc
  tags            String[] @default([])
  isActive        Boolean  @default(true) @map("is_active")
  
  // Relationships
  versions        PromptVersion[]
  abTests         ABTest[]
  metrics         PromptMetric[]
  
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  // Constraints
  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([operation])
  @@map("prompt_templates")
}

model PromptVersion {
  id              String   @id @default(cuid())
  templateId      String   @map("template_id")
  template        PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  // Version info
  version         Int      // 1, 2, 3, ...
  content         String   // The actual prompt
  variables       String[] @default([]) // {taskTitle}, {description}, etc
  
  // Testing & Status
  isActive        Boolean  @default(false) @map("is_active")
  description     String?
  changelog       String?
  author          String?
  
  // Relationships
  abTestsAsControl    ABTest[] @relation("control")
  abTestsAsTreatment  ABTest[] @relation("treatment")
  metrics         PromptMetric[]
  
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  
  @@unique([templateId, version])
  @@index([templateId])
  @@map("prompt_versions")
}

model ABTest {
  id                  String   @id @default(cuid())
  templateId          String   @map("template_id")
  template            PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  // Versions being tested
  controlVersionId    String   @map("control_version_id")
  controlVersion      PromptVersion @relation("control", fields: [controlVersionId], references: [id], onDelete: Cascade)
  
  treatmentVersionId  String   @map("treatment_version_id")
  treatmentVersion    PromptVersion @relation("treatment", fields: [treatmentVersionId], references: [id], onDelete: Cascade)
  
  // Test status
  status              String   @default("running") // running, completed, winner_selected
  winner              String?  // "control" or "treatment"
  
  // Config
  sampleSize          Int?     @map("sample_size")
  startDate           DateTime @default(now()) @map("start_date") @db.Timestamptz(6)
  endDate             DateTime? @map("end_date") @db.Timestamptz(6)
  
  // Relationships
  metrics             PromptMetric[]
  
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  @@index([templateId])
  @@index([status])
  @@map("ab_tests")
}

model PromptMetric {
  id              String   @id @default(cuid())
  templateId      String   @map("template_id")
  template        PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  versionId       String   @map("version_id")
  version         PromptVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  
  abTestId        String?  @map("ab_test_id")
  abTest          ABTest?  @relation(fields: [abTestId], references: [id], onDelete: SetNull)
  
  // Performance metrics
  operation       String   // classify, summarize, etc
  success         Boolean
  accuracy        Float?   // 0-1 confidence
  latencyMs       Int      @map("latency_ms")
  tokenCount      Int      @map("token_count")
  costUsd         Float    @map("cost_usd")
  
  // Quality metrics
  userRating      Int?     @map("user_rating") // 1-5 stars
  relevance       Float?   // AI-scored relevance
  
  // Context
  taskId          String?  @map("task_id")
  userId          String?  @map("user_id")
  
  recordedAt      DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  
  @@index([templateId])
  @@index([versionId])
  @@index([abTestId])
  @@index([recordedAt])
  @@map("prompt_metrics")
}

// Phase 4.3: Classification Service
model ClassificationTaxonomy {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id") @db.Uuid
  name              String
  description       String?
  
  categories        ClassificationCategory[]
  classifiers       Classifier[]
  trainingDatasets  TrainingDataset[]
  metrics           ClassificationMetric[]
  
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("classification_taxonomies")
}

model ClassificationCategory {
  id                String   @id @default(cuid())
  taxonomyId        String   @map("taxonomy_id")
  taxonomy          ClassificationTaxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)
  
  name              String
  description       String?
  rules             String[] @default([])
  exampleKeywords   String[] @default([])
  
  metrics           ClassificationMetric[]
  
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  @@unique([taxonomyId, name])
  @@index([taxonomyId])
  @@map("classification_categories")
}

model TrainingDataset {
  id                String   @id @default(cuid())
  taxonomyId        String   @map("taxonomy_id")
  taxonomy          ClassificationTaxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)
  
  version           Int
  description       String?
  size              Int      @default(0)
  
  trainingExamples  TrainingExample[]
  classifiers       Classifier[]
  
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  
  @@unique([taxonomyId, version])
  @@index([taxonomyId])
  @@map("training_datasets")
}

model TrainingExample {
  id                String   @id @default(cuid())
  datasetId         String   @map("dataset_id")
  dataset           TrainingDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  
  text              String
  category          String
  confidence        Float    @default(1.0)
  
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  
  @@index([datasetId])
  @@map("training_examples")
}

model Classifier {
  id                String   @id @default(cuid())
  taxonomyId        String   @map("taxonomy_id")
  taxonomy          ClassificationTaxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)
  
  trainingDatasetId String   @map("training_dataset_id")
  trainingDataset   TrainingDataset @relation(fields: [trainingDatasetId], references: [id], onDelete: Restrict)
  
  version           Int
  modelType         String   @map("model_type") // "prompt", "fine-tuned", "ensemble"
  metadata          Json     @default("{}")
  
  isActive          Boolean  @default(false) @map("is_active")
  accuracy          Float?
  
  metrics           ClassificationMetric[]
  
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  @@unique([taxonomyId, version])
  @@index([taxonomyId])
  @@map("classifiers")
}

model ClassificationMetric {
  id                String   @id @default(cuid())
  taxonomyId        String   @map("taxonomy_id")
  taxonomy          ClassificationTaxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)
  
  categoryId        String   @map("category_id")
  category          ClassificationCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  classifierId      String?  @map("classifier_id")
  classifier        Classifier? @relation(fields: [classifierId], references: [id], onDelete: SetNull)
  
  // Confusion matrix
  truePositives     Int      @default(0) @map("true_positives")
  falsePositives    Int      @default(0) @map("false_positives")
  falseNegatives    Int      @default(0) @map("false_negatives")
  trueNegatives     Int      @default(0) @map("true_negatives")
  
  // Calculated metrics
  precision         Float?
  recall            Float?
  f1Score           Float?   @map("f1_score")
  
  recordedAt        DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  
  @@index([taxonomyId])
  @@index([classifierId])
  @@index([recordedAt])
  @@map("classification_metrics")
}

// ============================================================================
// PHASE 5: CROSS-PLATFORM MODELS
// ============================================================================

enum SyncStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum DevicePlatform {
  IOS
  ANDROID
  MACOS
  WINDOWS
  WEB
}

enum ConflictResolutionStrategy {
  LAST_WRITE_WINS
  MANUAL_RESOLUTION
  KEEP_LOCAL
  KEEP_REMOTE
}

// Phase 7: Additional Integrations enums
enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  SYNC_IN_PROGRESS
  NEEDS_REAUTH
}

enum PermissionType {
  READ_MESSAGES
  WRITE_MESSAGES
  MANAGE_CALENDAR
  READ_CALENDAR
  CREATE_TASKS
  MANAGE_TASKS
  READ_PROFILE
  SYNC_CHATS
  SYNC_EMAILS
  SYNC_CALENDAR
}

enum PermissionStatus {
  REQUESTED
  GRANTED
  DENIED
  REVOKED
  EXPIRED
}

enum WebhookStatus {
  ACTIVE
  INACTIVE
  FAILED
  EXPIRED
}

model DeviceInfo {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  platform        DevicePlatform
  osVersion       String          @map("os_version")
  appVersion      String          @map("app_version")
  deviceName      String?         @map("device_name")
  deviceId        String          @unique @map("device_id")
  capabilities    Json            @default("{}") // Storage limit, sync frequency, etc
  syncStatus      SyncStatus      @default(PENDING)
  lastSyncAt      DateTime?       @map("last_sync_at") @db.Timestamptz(6)
  lastActivityAt  DateTime?       @map("last_activity_at") @db.Timestamptz(6)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  syncLogs        DeviceSyncLog[]
  offlineTasks    OfflineTask[]
  syncQueue       SyncQueueItem[]
  
  @@index([workspaceId, userId])
  @@index([syncStatus])
  @@index([lastSyncAt])
  @@map("device_info")
}

model DeviceSyncLog {
  id              String          @id @default(uuid()) @db.Uuid
  deviceId        String          @map("device_id") @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  syncStatus      SyncStatus
  itemsProcessed  Int             @default(0) @map("items_processed")
  itemsFailed     Int             @default(0) @map("items_failed")
  conflictsFound  Int             @default(0) @map("conflicts_found")
  duration        Int?            @map("duration_ms") // milliseconds
  errorMessage    String?         @map("error_message")
  metadata        Json            @default("{}") // Additional sync details
  startedAt       DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  
  device          DeviceInfo      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  @@index([deviceId, createdAt])
  @@index([workspaceId, syncStatus])
  @@index([startedAt])
  @@map("device_sync_logs")
}

model OfflineTask {
  id              String          @id @default(uuid()) @db.Uuid
  deviceId        String          @map("device_id") @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  taskId          String?         @map("task_id") @db.Uuid
  operation       String          // CREATE, UPDATE, DELETE
  taskData        Json                              // Snapshot of task data
  syncedAt        DateTime?       @map("synced_at") @db.Timestamptz(6)
  syncAttempts    Int             @default(0) @map("sync_attempts")
  lastSyncError   String?         @map("last_sync_error")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  device          DeviceInfo      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  @@index([deviceId, syncedAt])
  @@index([workspaceId, syncedAt])
  @@index([createdAt])
  @@map("offline_tasks")
}

model SyncQueueItem {
  id              String          @id @default(uuid()) @db.Uuid
  deviceId        String          @map("device_id") @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  itemType        String          // task, reminder, note, etc
  itemId          String          @map("item_id") @db.Uuid
  operation       String          // CREATE, UPDATE, DELETE
  priority        Priority        @default(MEDIUM)
  status          SyncStatus      @default(PENDING)
  payload         Json            // Operation data
  processedAt     DateTime?       @map("processed_at") @db.Timestamptz(6)
  errorMessage    String?         @map("error_message")
  retryCount      Int             @default(0) @map("retry_count")
  maxRetries      Int             @default(3) @map("max_retries")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  device          DeviceInfo      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  @@index([workspaceId, status, priority])
  @@index([deviceId, status])
  @@index([createdAt])
  @@map("sync_queue_items")
}

model SyncConflict {
  id              String          @id @default(uuid()) @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  itemType        String          // task, reminder, etc
  itemId          String          @map("item_id") @db.Uuid
  localData       Json            @map("local_data")
  remoteData      Json            @map("remote_data")
  strategy        ConflictResolutionStrategy @default(LAST_WRITE_WINS)
  resolution      Json?
  resolvedAt      DateTime?       @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  @@index([workspaceId, resolvedAt])
  @@index([itemType, itemId])
  @@map("sync_conflicts")
}

// ===== PHASE 7: ADDITIONAL INTEGRATIONS =====

// ExternalIntegration: Provider account connections
model ExternalIntegration {
  id                String                    @id @default(uuid()) @db.Uuid
  workspaceId       String                    @map("workspace_id") @db.Uuid
  userId            String                    @map("user_id") @db.Uuid
  provider          String                    // teams, outlook, calendar, github, microsoft, google
  displayName       String                    @map("display_name")
  externalAccountId String                    @map("external_account_id")
  externalEmail     String?                   @map("external_email")
  status            IntegrationStatus         @default(DISCONNECTED)
  lastSyncedAt      DateTime?                 @map("last_synced_at") @db.Timestamptz(6)
  nextSyncAt        DateTime?                 @map("next_sync_at") @db.Timestamptz(6)
  syncFrequency     Int                       @default(3600) @map("sync_frequency") // seconds
  metadata          Json                      @default("{}")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  workspace         Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions       IntegrationPermission[]
  syncLogs          IntegrationSyncLog[]
  tasks             ProviderTask[]
  events            ProviderEvent[]
  notifications     ProviderNotification[]
  apiUsage          ProviderAPIUsage[]
  
  @@unique([workspaceId, userId, provider, externalAccountId])
  @@index([workspaceId, status])
  @@index([userId, provider])
  @@index([nextSyncAt])
  @@map("external_integrations")
}

// IntegrationPermission: Granular permissions for each integration
model IntegrationPermission {
  id                String              @id @default(uuid()) @db.Uuid
  integrationId     String              @map("integration_id") @db.Uuid
  permission        PermissionType
  scope             String              // email, calendar, chats, messages, tasks, etc
  status            PermissionStatus    @default(REQUESTED)
  grantedAt         DateTime?           @map("granted_at") @db.Timestamptz(6)
  revokedAt         DateTime?           @map("revoked_at") @db.Timestamptz(6)
  expiresAt         DateTime?           @map("expires_at") @db.Timestamptz(6)
  metadata          Json                @default("{}")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  integration       ExternalIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  
  @@unique([integrationId, permission, scope])
  @@index([integrationId, status])
  @@index([expiresAt])
  @@map("integration_permissions")
}

// IntegrationSyncLog: Track all sync operations
model IntegrationSyncLog {
  id                String              @id @default(uuid()) @db.Uuid
  integrationId     String              @map("integration_id") @db.Uuid
  syncType          String              // full, incremental, chats, emails, events
  status            SyncStatus          @default(PENDING)
  itemsProcessed    Int                 @default(0) @map("items_processed")
  itemsSucceeded    Int                 @default(0) @map("items_succeeded")
  itemsFailed       Int                 @default(0) @map("items_failed")
  conflictCount     Int                 @default(0) @map("conflict_count")
  startedAt         DateTime            @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?           @map("completed_at") @db.Timestamptz(6)
  durationMs        Int?                @map("duration_ms")
  errorMessage      String?             @map("error_message") @db.Text
  metadata          Json                @default("{}")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  
  integration       ExternalIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  
  @@index([integrationId, createdAt])
  @@index([status, startedAt])
  @@map("integration_sync_logs")
}

// ProviderTask: Mapping between local tasks and provider tasks
model ProviderTask {
  id                String              @id @default(uuid()) @db.Uuid
  integrationId     String              @map("integration_id") @db.Uuid
  taskId            String              @map("task_id") @db.Uuid
  externalTaskId    String              @map("external_task_id")
  provider          String
  externalStatus    String              @map("external_status")
  lastSyncedAt      DateTime?           @map("last_synced_at") @db.Timestamptz(6)
  syncDirection     String              @default("bidirectional") @map("sync_direction") // bidirectional, one-way-to, one-way-from
  conflictData      Json?               @map("conflict_data")
  metadata          Json                @default("{}")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  integration       ExternalIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  task              Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  @@unique([integrationId, externalTaskId])
  @@unique([taskId, integrationId])
  @@index([integrationId, lastSyncedAt])
  @@map("provider_tasks")
}

// ProviderEvent: External events from providers
model ProviderEvent {
  id                String              @id @default(uuid()) @db.Uuid
  integrationId     String              @map("integration_id") @db.Uuid
  externalEventId   String              @map("external_event_id")
  type              String              // meeting, reminder, task-update, chat-message
  title             String?
  description       String?             @db.Text
  startTime         DateTime?           @map("start_time") @db.Timestamptz(6)
  endTime           DateTime?           @map("end_time") @db.Timestamptz(6)
  organizer         String?
  attendees         String[]            @default([])
  location          String?
  metadata          Json                @default("{}")
  processedAt       DateTime?           @map("processed_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  
  integration       ExternalIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  
  @@unique([integrationId, externalEventId])
  @@index([integrationId, type])
  @@index([startTime])
  @@map("provider_events")
}

// ProviderNotification: Webhook subscriptions and notifications
model ProviderNotification {
  id                String              @id @default(uuid()) @db.Uuid
  integrationId     String              @map("integration_id") @db.Uuid
  webhookId         String              @map("webhook_id")
  eventType         String              @map("event_type") // message, event-created, task-updated
  webhookUrl        String              @map("webhook_url") @db.Text
  subscriptionId    String              @map("subscription_id")
  expiresAt         DateTime?           @map("expires_at") @db.Timestamptz(6)
  status            WebhookStatus       @default(ACTIVE)
  lastTriggeredAt   DateTime?           @map("last_triggered_at") @db.Timestamptz(6)
  failureCount      Int                 @default(0) @map("failure_count")
  metadata          Json                @default("{}")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  integration       ExternalIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  
  @@unique([integrationId, webhookId, eventType])
  @@index([integrationId, status])
  @@index([expiresAt])
  @@map("provider_notifications")
}

// ProviderAPIUsage: Track API rate limits and usage
model ProviderAPIUsage {
  id                String              @id @default(uuid()) @db.Uuid
  integrationId     String              @map("integration_id") @db.Uuid
  date              DateTime            @db.Date
  requestCount      Int                 @default(0) @map("request_count")
  limitPerDay       Int                 @default(0) @map("limit_per_day")
  limitPerMinute    Int                 @default(0) @map("limit_per_minute")
  resetAt           DateTime            @map("reset_at") @db.Timestamptz(6)
  metadata          Json                @default("{}")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  integration       ExternalIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  
  @@unique([integrationId, date])
  @@index([integrationId, resetAt])
  @@map("provider_api_usage")
}